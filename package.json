{
  "name": "lazy-prime",
  "private": true,
  "description": "Lazy Prime tools and interface extensions for pi and prime-agent",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "lazy-prime",
    "pi-package",
    "pi-extension",
    "prime-agent"
  ],
  "author": "Ephraim Duncan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ephraimduncan/lazy-prime.git"
  },
  "bin": {
    "lazy-prime": "./bin/lazy-prime.mjs"
  },
  "pi": {
    "extensions": [
      "./packages/pi-read/index.ts",
      "./packages/pi-write/index.ts",
      "./packages/pi-hashline-edit/index.ts",
      "./packages/pi-search/index.ts",
      "./packages/pi-find/index.ts",
      "./packages/pi-ast-grep/index.ts",
      "./packages/pi-ast-edit/index.ts",
      "./packages/lazy-prime-statusline/index.ts",
      "./packages/lazy-prime-gates/index.ts",
      "./packages/pi-todo/index.ts",
      "./packages/pi-web-search/index.ts",
      "./packages/pi-github/index.ts",
      "./packages/pi-browser/index.ts",
      "./packages/pi-inspect-image/index.ts",
      "./packages/pi-tmp-scratch/index.ts",
      "./packages/pi-bash/index.ts",
      "./packages/pi-task/index.ts",
      "./packages/pi-ask/index.ts"
    ],
    "themes": [
      "./themes/lazy-prime-dark.prime.json"
    ]
  },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^24.0.0"
  }
}